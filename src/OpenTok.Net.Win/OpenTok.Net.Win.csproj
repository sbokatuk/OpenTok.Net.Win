<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a binding, unlike its two sibling repositories.

    OpenTok.Client is already managed .NET — OpenTokNetStandard.dll, netstandard2.0 — so there is no
    Objective-C or Java surface to project and nothing here is generated. What this package adds is
    the piece Vonage does not ship: a WinUI 3 video renderer. The SDK's own WPFVideoRenderer and
    WinFormsVideoRenderer cannot be used from WinUI, and its netstandard2.0 asset — the one a modern
    .NET app resolves — carries no renderer at all. See README.md.
  -->

  <PropertyGroup>
    <TargetFrameworks>$(OpenTokTargetFrameworks)</TargetFrameworks>
    <UseWinUI>true</UseWinUI>

    <!--
      For the frame conversion only. VideoFrame hands out raw plane pointers that are valid just for
      the duration of the RenderFrame callback, so the alternative to reading them through a Span is
      Marshal.Copy into a managed array on every frame — a second full copy of every frame, at 30
      frames a second, to avoid one clearly scoped block.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OpenTok.Net.Win</PackageId>
    <Title>WinUI 3 video rendering for the Vonage Video Windows SDK.</Title>
    <Description>A WinUI 3 video renderer and view for Vonage's OpenTok Windows SDK (OpenTok.Client $(OpenTokClientPackageVersion)), so a WinUI or .NET MAUI app can display OpenTok video. The SDK's own renderers target WPF and Windows Forms, and its netstandard2.0 assembly — the one modern .NET resolves — ships none at all. Adds OpenTokVideoView, OpenTokVideoRenderer and OpenTokDispatcher. Requires x64: the SDK's native payload has no arm64 build.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTok.Client" Version="$(OpenTokClientPackageVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="build/OpenTok.Net.Win.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!--
    Keep OpenTok.Client's native payload out of *this* package.

    OpenTok.Client ships build/OpenTok.Client.targets, which globs its own package directory and adds
    opentok.dll and the three capturers as @(Content) with CopyToOutputDirectory. Right for an
    application, wrong for a library that gets packed: those Content items were written into this
    package, so a consumer restored OpenTok.Net.Win and then tried to copy
    lib/net9.0-windows10.0.19041/OpenTok.Net.Win/DshowCapturer.dll — a path recorded at our pack time
    that exists nowhere in the package recording it. Four MSB3030s in the sample.

    Costs a consumer nothing: OpenTok.Client is a dependency of this package, so its targets run in
    the consuming project and copy the real files out of the real package directory. The sample job's
    native-payload check is the assertion that this still happens.

    A target rather than an ItemGroup in the project body, because NuGet imports a dependency's
    build/*.targets *after* the body — the items do not exist yet when the body is evaluated.

    Not IncludeContentInPack=false, which was the first attempt and is a trap: despite the name it
    guards the whole of NuGet's _GetPackageFiles target, so it also drops @(None) items with an
    explicit Pack="true" — the README and the LICENCE — and the pack fails with NU5030 rather than
    silently. Hence matching on the extension instead: this project has no @(Content) .dll of its
    own, so any that appears came from a dependency and belongs to that dependency's package.
  -->
  <Target Name="OpenTokExcludeSdkNativeContentFromPack" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <ItemGroup>
      <Content Update="@(Content)" Pack="false" Condition=" '%(Extension)' == '.dll' " />
    </ItemGroup>
  </Target>

</Project>
